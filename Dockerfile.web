FROM node:22-alpine

# T4 套表和邮件发送使用隔离的 Python 环境，避免依赖宿主机 PATH。
RUN apk add --no-cache python3 py3-pip \
    && python3 -m venv /opt/t4-venv \
    && /opt/t4-venv/bin/pip install --no-cache-dir openpyxl

ENV T4_PYTHON=/opt/t4-venv/bin/python \
    PYTHONUNBUFFERED=1

WORKDIR /app
CMD ["node", "server.js", "5180"]
